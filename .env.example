# ── PostgreSQL ───────────────────────────────────────────────
# Локально: строка подключения к своей БД.
# В Docker Compose DATABASE_URL собирается автоматически из POSTGRES_* ниже.
DATABASE_URL=postgres://moisklad:change-me@localhost:5432/moisklad
# PG_SSL=true            # только для managed-БД с TLS
# PG_POOL_MAX=10

# Учётные данные Postgres для docker-compose (db-сервис).
POSTGRES_USER=moisklad
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=moisklad

# ── Файловое хранилище ───────────────────────────────────────
# Где лежат XLSX-листы (и далее стикеры/фото). В Docker — /data/files (volume).
FILES_DIR=./data/files

# ── «Мой склад» ──────────────────────────────────────────────
MOYSKLAD_LOGIN=your_login@example.com
MOYSKLAD_PASSWORD=your_password

# ── Автосбор (worker) ────────────────────────────────────────
# Секрет авторизации запроса воркера к /api/generate.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=change-me-to-a-random-string
CRON_HOUR_MSK=11
CRON_MIN_MSK=5

# ── Вход в панель ────────────────────────────────────────────
# Логин/пароль лежат в таблице moi_sklad_auth, тут только секрет подписи
# httpOnly-cookie сессии. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=change-me-to-a-random-64-hex-string

# ── Коннектор ВБ ↔ МойСклад ──────────────────────────────────
# Ключ шифрования WB-токенов и паролей клиентов в БД (AES-256-GCM).
# 64 hex-символа = 32 байта:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WB_TOKEN_ENC_KEY=change-me-to-a-random-64-hex-string
