# ── «Мой склад» ──────────────────────────────────────────────
MOYSKLAD_LOGIN=your_login@example.com
MOYSKLAD_PASSWORD=your_password

# ── Supabase (Dashboard → Settings → API) ────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...anon            # чтение списка листов
SUPABASE_SERVICE_ROLE_KEY=eyJ...service # ОБЯЗАТЕЛЬНО: запись в Storage/таблицу

# ── Vercel Cron ──────────────────────────────────────────────
# Vercel шлёт Authorization: Bearer $CRON_SECRET на /api/generate.
# Придумайте случайную строку и задайте её же в Vercel env.
CRON_SECRET=change-me-to-a-random-string
