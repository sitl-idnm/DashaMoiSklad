# Учётные данные «Мой склад» (скопируйте в .env и заполните)
MOYSKLAD_LOGIN=your_login@example.com
MOYSKLAD_PASSWORD=your_password

# Необязательно
# Папка для сохранения XLSX в CLI-режиме (по умолчанию ./output)
OUTPUT_FOLDER=./output
# Хост/порт веб-панели (по умолчанию 127.0.0.1:8000)
HOST=127.0.0.1
PORT=8000
